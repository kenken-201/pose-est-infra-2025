# Cloudflare Credentials
# Create a token with: Zone:Edit, DNS:Edit, Pages:Edit, R2:Edit
CLOUDFLARE_API_TOKEN=

# Account ID found in Cloudflare Dashboard URL
CLOUDFLARE_ACCOUNT_ID=

# GCP Configuration
GCP_PROJECT_ID=
GCP_REGION=

# R2 Access Keys (For Terraform Backend and App use)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 Endpoint (optional, for checking)
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Cloud Run Backend URL (used for DNS CNAME target)
# e.g., https://pose-est-backend-dev-xxx.a.run.app
TF_VAR_dev_cloud_run_url=
